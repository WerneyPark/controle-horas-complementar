{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ControleHoras",
  "version": "1.0.0",
  "identifier": "com.controlehoras.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Controle de Horas Complementares",
        "width": 1100,
        "height": 750,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
